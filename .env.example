# Copy this file to ".env" for local development.
# ".env" is gitignored — never commit real keys.

# Korapay secret key. Use a TEST key for now.
# Get it at: https://merchant.korapay.com  (Settings -> API Keys & Webhooks)
KORAPAY_SECRET_KEY=<paste-your-korapay-secret-key>

# Collection currency: NGN | GHS | KES | USD  (default NGN)
KORAPAY_CURRENCY=NGN

# Admin console passcode (optional; defaults to "vetu-admin").
VITE_ADMIN_PASSCODE=vetu-admin
