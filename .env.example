# Copy this file to ".env" for local development.
# ".env" is gitignored — never commit real keys.

# Admin passcode (client + server must match so the dashboard can save gateway keys).
VITE_ADMIN_PASSCODE=vetu-admin
ADMIN_PASSCODE=vetu-admin

# Which gateway is active for checkout: korapay | paystack | flutterwave | stripe
ACTIVE_GATEWAY=korapay

# Optional: seed gateway keys here (the admin UI can also set them at runtime).
# Use TEST keys for now.
KORAPAY_SECRET_KEY=
KORAPAY_CURRENCY=NGN

PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

FLW_SECRET_KEY=
FLW_CURRENCY=NGN

STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# Where server-stored gateway keys are written (defaults to server/data).
# On Render with a persistent disk, set this to the disk mount path, e.g. /data
# DATA_DIR=/data
