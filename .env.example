# Copy this file to ".env" for local development.
# ".env" is gitignored — never commit real keys.

# Stripe secret key. Use a TEST key for now (its id starts with "sk", then "_test_").
# Get it at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=<paste-your-test-key-here>

# Admin console passcode (optional; defaults to "vetu-admin").
VITE_ADMIN_PASSCODE=vetu-admin
